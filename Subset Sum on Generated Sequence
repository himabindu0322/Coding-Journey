import java.util.ArrayList;
import java.util.List;

class Solution {
    public boolean isPossible(int[] arr, int s, int x) {
        if (x == 0) {
            return true;
        }

        List<Long> seq = new ArrayList<>();
        long prefSum = s;
        seq.add((long) s);

        // Generate elements of the sequence until current value exceeds x or array ends
        for (int val : arr) {
            if (prefSum > x) {
                break;
            }
            long cur = prefSum + val;
            seq.add(cur);
            prefSum += cur;
        }

        // Greedy traversal from right to left
        long target = x;
        for (int i = seq.size() - 1; i >= 0; i--) {
            long num = seq.get(i);
            if (target >= num) {
                target -= num;
            }
        }

        return target == 0;
    }
}

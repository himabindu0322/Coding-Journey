import java.util.Scanner;

class Codechef {
    public static void main (String[] args) throws java.lang.Exception {
        Scanner sc = new Scanner(System.in);
        
        if (sc.hasNextInt()) {
            int T = sc.nextInt();
            
            while (T-- > 0) {
                int N = sc.nextInt();
                int[] A = new int[2 * N];
                
                for (int i = 0; i < 2 * N; i++) {
                    A[i] = sc.nextInt();
                }
                
                long maxFirstHalfSum = 0;
                
                // Compare each element with its mirror element
                for (int i = 0; i < N; i++) {
                    int mirrorIndex = 2 * N - 1 - i;
                    maxFirstHalfSum += Math.max(A[i], A[mirrorIndex]);
                }
                
                System.out.println(maxFirstHalfSum);
            }
        }
        
        sc.close();
    }
}

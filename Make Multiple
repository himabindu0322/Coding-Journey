import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef {
    public static void main (String[] args) throws java.lang.Exception {
        Scanner sc = new Scanner(System.in);
        if (sc.hasNextInt()) {
            int t = sc.nextInt();
            while (t-- > 0) {
                int n = sc.nextInt();

                // If already divisible by 3
                if (n % 3 == 0) {
                    System.out.println(0);
                    continue;
                }

                // Check if 1 operation is enough
                // 1. Add 1 -> (n + 1) % 3 == 0
                // 2. Jump to next multiple of 5 -> nextMult5 % 3 == 0
                int nextMult5 = 5 * (n / 5 + 1);

                if ((n + 1) % 3 == 0 || nextMult5 % 3 == 0) {
                    System.out.println(1);
                } else {
                    // Maximum operations needed to reach a multiple of 3 is 2
                    System.out.println(2);
                }
            }
        }
        sc.close();
    }
}

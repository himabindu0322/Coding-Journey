class Solution {
    public int minProd(int[] arr) {
        int n = arr.length;
        if (n == 1) {
            return arr[0];
        }

        int maxNeg = Integer.MIN_VALUE; // Largest negative number (closest to 0)
        int minPos = Integer.MAX_VALUE; // Smallest positive number
        int countNeg = 0;
        int countZero = 0;
        int prod = 1;

        for (int i = 0; i < n; i++) {
            if (arr[i] == 0) {
                countZero++;
                continue;
            }

            if (arr[i] < 0) {
                countNeg++;
                maxNeg = Math.max(maxNeg, arr[i]);
            } else {
                minPos = Math.min(minPos, arr[i]);
            }

            prod *= arr[i];
        }

        // Case 1: No negative numbers
        if (countNeg == 0) {
            if (countZero > 0) {
                return 0;
            }
            return minPos;
        }

        // Case 2: Even count of negative numbers (and at least 1 negative exists)
        if (countNeg % 2 == 0) {
            // Exclude maxNeg (the negative number closest to 0) to keep the product negative
            prod /= maxNeg;
        }

        return prod;
    }
}

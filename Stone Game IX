class Solution {
    public boolean stoneGameIX(int[] stones) {
        int c0 = 0, c1 = 0, c2 = 0;

        // Count frequency of each modulo 3 remainder
        for (int stone : stones) {
            int rem = stone % 3;
            if (rem == 0) c0++;
            else if (rem == 1) c1++;
            else c2++;
        }

        // Case 1: Even number of 0-stones
        if (c0 % 2 == 0) {
            return c1 >= 1 && c2 >= 1;
        }

        // Case 2: Odd number of 0-stones
        return Math.abs(c1 - c2) >= 3;
    }
}

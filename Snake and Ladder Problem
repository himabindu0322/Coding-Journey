import java.util.*;

class Solution {
    public int minThrows(int n, int[] lad, int[] sn) {
        int targetCell = n * n;
        
        // Lookup array where target[i] points to the destination cell after snake/ladder
        int[] target = new int[targetCell + 1];
        for (int i = 1; i <= targetCell; i++) {
            target[i] = i;
        }

        // Add ladders
        for (int i = 0; i < lad.length; i += 2) {
            target[lad[i]] = lad[i + 1];
        }

        // Add snakes
        for (int i = 0; i < sn.length; i += 2) {
            target[sn[i]] = sn[i + 1];
        }

        // BFS setup: store pairs of [cell, moves]
        Queue<int[]> queue = new LinkedList<>();
        boolean[] visited = new boolean[targetCell + 1];

        // Start at cell 1 with 0 moves
        queue.offer(new int[]{1, 0});
        visited[1] = true;

        while (!queue.isEmpty()) {
            int[] current = queue.poll();
            int cell = current[0];
            int moves = current[1];

            if (cell == targetCell) {
                return moves;
            }

            // Try all 6 possible dice rolls
            for (int dice = 1; dice <= 6; dice++) {
                int nextCell = cell + dice;

                if (nextCell <= targetCell) {
                    // Move through ladder or snake if present
                    int dest = target[nextCell];

                    if (!visited[dest]) {
                        visited[dest] = true;
                        queue.offer(new int[]{dest, moves + 1});
                    }
                }
            }
        }

        return -1; // Destination cell n*n is unreachable
    }
}

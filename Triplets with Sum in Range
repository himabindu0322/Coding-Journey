import java.util.Arrays;

class Solution {

    public int countTriplets(int[] arr, int l, int r) {
        Arrays.sort(arr);
        return countTripletsLessOrEqual(arr, r) - countTripletsLessOrEqual(arr, l - 1);
    }

    private int countTripletsLessOrEqual(int[] arr, int val) {
        int n = arr.length;
        int count = 0;

        for (int i = 0; i < n - 2; i++) {
            int j = i + 1;
            int k = n - 1;

            while (j < k) {
                int sum = arr[i] + arr[j] + arr[k];

                if (sum <= val) {
                    // All elements between j and k form valid triplets with arr[i] and arr[j]
                    count += (k - j);
                    j++;
                } else {
                    k--;
                }
            }
        }

        return count;
    }
}

import java.util.ArrayList;

class Solution {
    public ArrayList<Integer> findWays(int[][] grid) {
        int n = grid.length;
        int MOD = 1000000007;

        // paths[i][j] stores number of valid paths to cell (i, j)
        int[][] paths = new int[n][n];
        // maxAdv[i][j] stores maximum adventure sum to cell (i, j)
        int[][] maxAdv = new int[n][n];

        // Base case: Starting at (0, 0)
        paths[0][0] = 1;
        maxAdv[0][0] = grid[0][0];

        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                // If cell (i, j) is unreachable, skip it
                if (paths[i][j] == 0 && (i != 0 || j != 0)) {
                    continue;
                }

                int val = grid[i][j];

                // Check if we can move RIGHT to (i, j + 1)
                if ((val == 1 || val == 3) && j + 1 < n) {
                    int nextVal = grid[i][j + 1];

                    // Update path count
                    paths[i][j + 1] = (paths[i][j + 1] + paths[i][j]) % MOD;

                    // Update max adventure sum
                    maxAdv[i][j + 1] = Math.max(maxAdv[i][j + 1], maxAdv[i][j] + nextVal);
                }

                // Check if we can move DOWN to (i + 1, j)
                if ((val == 2 || val == 3) && i + 1 < n) {
                    int nextVal = grid[i + 1][j];

                    // Update path count
                    paths[i + 1][j] = (paths[i + 1][j] + paths[i][j]) % MOD;

                    // Update max adventure sum
                    maxAdv[i + 1][j] = Math.max(maxAdv[i + 1][j], maxAdv[i][j] + nextVal);
                }
            }
        }

        ArrayList<Integer> result = new ArrayList<>();
        result.add(paths[n - 1][n - 1]);
        result.add(maxAdv[n - 1][n - 1]);

        return result;
    }
}

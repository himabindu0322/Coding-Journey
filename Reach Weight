import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		if (sc.hasNextInt()) {
			int T = sc.nextInt();
			while (T-- > 0) {
				int N = sc.nextInt();
				int cost = (N / 2) * 30 + (N % 2) * 20;
				System.out.println(cost);
			}
		}
		sc.close();
	}
}

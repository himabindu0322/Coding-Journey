public class Solution {

    static class Element {
        int val;
        int index;

        Element(int val, int index) {
            this.val = val;
            this.index = index;
        }
    }

    public static int[] countSmaller(int[] nums) {
        int n = nums.length;
        int[] counts = new int[n];
        
        Element[] arr = new Element[n];
        for (int i = 0; i < n; i++) {
            arr[i] = new Element(nums[i], i);
        }

        mergeSortAndCount(arr, 0, n - 1, counts);
        return counts;
    }

    private static void mergeSortAndCount(Element[] arr, int left, int right, int[] counts) {
        if (left >= right) return;

        int mid = left + (right - left) / 2;
        mergeSortAndCount(arr, left, mid, counts);
        mergeSortAndCount(arr, mid + 1, right, counts);

        merge(arr, left, mid, right, counts);
    }

    private static void merge(Element[] arr, int left, int mid, int right, int[] counts) {
        Element[] temp = new Element[right - left + 1];
        int i = left;
        int j = mid + 1;
        int k = 0;
        int rightCount = 0; // Number of elements from right half that are smaller

        while (i <= mid && j <= right) {
            // If right element is smaller, increment rightCount
            if (arr[j].val < arr[i].val) {
                rightCount++;
                temp[k++] = arr[j++];
            } else {
                // Left element is smaller or equal -> add accumulated rightCount
                counts[arr[i].index] += rightCount;
                temp[k++] = arr[i++];
            }
        }

        while (i <= mid) {
            counts[arr[i].index] += rightCount;
            temp[k++] = arr[i++];
        }

        while (j <= right) {
            temp[k++] = arr[j++];
        }

        System.arraycopy(temp, 0, arr, left, temp.length);
    }
}

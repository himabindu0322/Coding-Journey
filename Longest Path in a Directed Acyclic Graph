import java.util.ArrayList;
import java.util.Arrays;
import java.util.Stack;

class Solution {
    
    static class Edge {
        int v, w;
        Edge(int v, int w) {
            this.v = v;
            this.w = w;
        }
    }

    public int[] maxDistance(int V, int src, ArrayList<ArrayList<Integer>> edges) {
        // Step 1: Build the Adjacency List
        ArrayList<ArrayList<Edge>> adj = new ArrayList<>();
        for (int i = 0; i < V; i++) {
            adj.add(new ArrayList<>());
        }
        for (ArrayList<Integer> edge : edges) {
            int u = edge.get(0);
            int v = edge.get(1);
            int w = edge.get(2);
            adj.get(u).add(new Edge(v, w));
        }

        // Step 2: Get Topological Sorting using DFS
        boolean[] visited = new boolean[V];
        Stack<Integer> stack = new Stack<>();
        for (int i = 0; i < V; i++) {
            if (!visited[i]) {
                topoSort(i, adj, visited, stack);
            }
        }

        // Step 3: Initialize distance array
        int[] dist = new int[V];
        Arrays.fill(dist, Integer.MIN_VALUE);
        dist[src] = 0;

        // Step 4: Process vertices in topological order
        while (!stack.isEmpty()) {
            int u = stack.pop();

            // Only relax edges if the current vertex u is reachable from src
            if (dist[u] != Integer.MIN_VALUE) {
                for (Edge edge : adj.get(u)) {
                    if (dist[u] + edge.w > dist[edge.v]) {
                        dist[edge.v] = dist[u] + edge.w;
                    }
                }
            }
        }

        return dist;
    }

    private void topoSort(int u, ArrayList<ArrayList<Edge>> adj, boolean[] visited, Stack<Integer> stack) {
        visited[u] = true;
        for (Edge edge : adj.get(u)) {
            if (!visited[edge.v]) {
                topoSort(edge.v, adj, visited, stack);
            }
        }
        stack.push(u);
    }
}

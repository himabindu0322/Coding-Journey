import java.util.*;

class Solution {
    public int minMoves(String[] classroom, int energy) {
        int m = classroom.length;
        int n = classroom[0].length();

        int startR = -1, startC = -1;
        List<int[]> litters = new ArrayList<>();

        // 1. Identify Start position and assign indices to Litter positions
        for (int r = 0; r < m; r++) {
            for (int c = 0; c < n; c++) {
                char ch = classroom[r].charAt(c);
                if (ch == 'S') {
                    startR = r;
                    startC = c;
                } else if (ch == 'L') {
                    litters.add(new int[]{r, c});
                }
            }
        }

        int numLitter = litters.size();
        if (numLitter == 0) return 0; // Edge case: No litter to collect

        // Map (r, c) of each Litter to its index bit
        int[][] litterIndex = new int[m][n];
        for (int i = 0; i < m; i++) Arrays.fill(litterIndex[i], -1);
        for (int i = 0; i < numLitter; i++) {
            litterIndex[litters.get(i)[0]][litters.get(i)[1]] = i;
        }

        int targetMask = (1 << numLitter) - 1;

        // BFS queue stores: {row, col, mask, remaining_energy}
        Queue<int[]> queue = new LinkedList<>();
        
        // Distance array: dist[r][c][mask][energy]
        int[][][][] dist = new int[m][n][1 << numLitter][energy + 1];
        for (int[][][] d1 : dist) {
            for (int[][] d2 : d1) {
                for (int[] d3 : d2) {
                    Arrays.fill(d3, -1);
                }
            }
        }

        // Initial state setup
        int startMask = 0;
        if (classroom[startR].charAt(startC) == 'L') {
            startMask |= (1 << litterIndex[startR][startC]);
        }
        
        queue.offer(new int[]{startR, startC, startMask, energy});
        dist[startR][startC][startMask][energy] = 0;

        int[][] dirs = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};

        while (!queue.isEmpty()) {
            int[] curr = queue.poll();
            int r = curr[0];
            int c = curr[1];
            int mask = curr[2];
            int e = curr[3];
            int d = dist[r][c][mask][e];

            // If all litter collected, return distance
            if (mask == targetMask) {
                return d;
            }

            // If remaining energy is 0 and we aren't on 'R', we cannot move further
            if (e == 0) continue;

            for (int[] dir : dirs) {
                int nr = r + dir[0];
                int nc = c + dir[1];

                // Boundary check & Obstacle check
                if (nr < 0 || nr >= m || nc < 0 || nc >= n || classroom[nr].charAt(nc) == 'X') {
                    continue;
                }

                char cellType = classroom[nr].charAt(nc);
                int nextMask = mask;
                int nextEnergy = e - 1;

                // Reset energy if stepping on 'R'
                if (cellType == 'R') {
                    nextEnergy = energy;
                }

                // Update mask if stepping on uncollected 'L'
                if (cellType == 'L') {
                    int idx = litterIndex[nr][nc];
                    if (idx != -1) {
                        nextMask |= (1 << idx);
                    }
                }

                if (dist[nr][nc][nextMask][nextEnergy] == -1) {
                    dist[nr][nc][nextMask][nextEnergy] = d + 1;
                    queue.offer(new int[]{nr, nc, nextMask, nextEnergy});
                }
            }
        }

        return -1; // Impossible to collect all litter
    }
}

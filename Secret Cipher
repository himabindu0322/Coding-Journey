import java.util.*;

class Solution {
    public String compress(String s) {
        int n = s.length();
        if (n == 0) return "";

        // Precompute KMP pi array
        int[] pi = new int[n];
        for (int i = 1; i < n; i++) {
            int j = pi[i - 1];
            while (j > 0 && s.charAt(i) != s.charAt(j)) {
                j = pi[j - 1];
            }
            if (s.charAt(i) == s.charAt(j)) {
                j++;
            }
            pi[i] = j;
        }

        StringBuilder sb = new StringBuilder();
        int i = n - 1;

        while (i >= 0) {
            int len = i + 1;
            boolean canCompress = false;

            // Check if current prefix of length 'len' can be split into identical halves
            if (len % 2 == 0) {
                int half = len / 2;
                int j = pi[i];
                
                // Find highest matching prefix length <= half
                while (j > half) {
                    j = pi[j - 1];
                }
                
                if (j == half) {
                    canCompress = true;
                }
            }

            if (canCompress) {
                sb.append('*');
                i = i / 2; // Jump to the end of the first half
            } else {
                sb.append(s.charAt(i));
                i--;
            }
        }

        return sb.reverse().toString();
    }
}
